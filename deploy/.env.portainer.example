# Portainer stack image and published ports
IMAGE_TAG=21f7635
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Public URLs used by browser clients and CORS
# Example: https://api.media.example.com
PUBLIC_BACKEND_URL=
# Example: https://media.example.com
PUBLIC_FRONTEND_URL=

# Initial administrator and JWT security
JWT_SIGNING_KEY=
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

# Azure Cosmos DB
AZURE_COSMOS_CONNECTION_STRING=
AZURE_COSMOS_DATABASE_NAME=datntdev.mediastudio

# Azure Storage
AZURE_STORAGE_BLOB_CONNECTION_STRING=
AZURE_STORAGE_QUEUE_CONNECTION_STRING=

# Optional Azure AI Foundry
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_API_KEY=

# Optional Azure Speech
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_API_KEY=
