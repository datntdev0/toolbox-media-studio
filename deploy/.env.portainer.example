# Portainer stack image and published ports
IMAGE_TAG=21f7635
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Public URLs used by browser clients and CORS
# Example: https://api.media.example.com
PUBLIC_BACKEND_URL=
# Example: https://media.example.com
PUBLIC_FRONTEND_URL=

# Initial administrator and JWT security
JWT_SIGNING_KEY=
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

# Azure Cosmos DB
AZURE_COSMOS_CONNECTION_STRING=
AZURE_COSMOS_DATABASE_NAME=datntdev.mediastudio

# Azure Storage
AZURE_STORAGE_BLOB_CONNECTION_STRING=
AZURE_STORAGE_QUEUE_CONNECTION_STRING=

# Optional Azure OpenAI
# Full base URL: https://<resource>.openai.azure.com/openai/v1/
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# Optional Google Gemini
GEMINI_API_KEY=

# Optional Azure Speech
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_API_KEY=

# Queue workers
QUEUE_WORKERS_SAMPLE=1
QUEUE_WORKERS_SCRAPINGS=2
QUEUE_WORKERS_TRANSLATIONS=1
QUEUE_WORKERS_WORKSPACES_TASKS=1
